{
  "name": "ai-sandbox-manager",
  "version": "0.1.8",
  "description": "Local control-plane GUI for Docker Sandboxes running Claude Code",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "scripts": {
    "predev": "node scripts/ensure-abi.mjs electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/ensure-abi.mjs node",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "use:electron-abi": "node scripts/ensure-abi.mjs electron --force",
    "use:node-abi": "node scripts/ensure-abi.mjs node --force",
    "predist": "node scripts/ensure-abi.mjs electron",
    "dist": "electron-vite build && electron-builder",
    "predist:dir": "node scripts/ensure-abi.mjs electron",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "better-sqlite3": "^12.11.1",
    "js-yaml": "^4.3.0"
  },
  "overrides": {
    "@electron/node-gyp": "10.2.0-electron.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
